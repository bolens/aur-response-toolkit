{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug CLI help",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--bin=aur-response",
          "--locked"
        ],
        "filter": {
          "name": "aur-response",
          "kind": "bin"
        }
      },
      "args": [
        "--help"
      ],
      "cwd": "${workspaceFolder}"
    }
  ]
}
