#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

if [ "${AUR_SKIP_HOOKS:-}" = "1" ]; then
  echo "AUR_SKIP_HOOKS=1 — skipping pre-commit checks" >&2
  exit 0
fi

if [ -z "$(git diff --cached --name-only --diff-filter=ACM)" ]; then
  echo "pre-commit: no staged files — skipping"
  exit 0
fi

cargo fmt --check
cargo clippy --all-targets --locked -- -D warnings
if [ "${AUR_HOOK_LINT_ONLY:-}" != "1" ]; then
  cargo test --locked
fi
echo "pre-commit: ok"
