#!/usr/bin/env fish
#
# Enforce Conventional Commits on the subject line (matches CI commitlint).
# Skip: AUR_SKIP_HOOKS=1 git commit ...

set -l msg_file $argv[1]
if test -z "$msg_file"; or not test -f $msg_file
    echo "error: commit-msg hook expected a message file" >&2
    exit 1
end

if set -q AUR_SKIP_HOOKS
    exit 0
end

set -l root (git rev-parse --show-toplevel)
set -l subject (head -n 1 -- $msg_file)

# Allow git-generated / workflow subjects that are not Conventional Commits.
if string match -qr '^(Merge |Revert |fixup! |squash! |Amend! )' -- $subject
    exit 0
end
if test -z (string trim -- $subject)
    exit 0
end

fish $root/scripts/check-conventional-commit.fish --message $subject
or begin
    echo "" >&2
    echo "commit-msg: subject must be Conventional Commits (see CONTRIBUTING.md)" >&2
    echo "  skip once: AUR_SKIP_HOOKS=1 git commit ..." >&2
    exit 1
end
