# Generated scan output
reports/*
!reports/.gitkeep
site/release.json

# Runtime state (cached package list fetch)
data/lists/*.previous.txt
.scan-state
.scan-findings.json

# History scrub backups
*.bak.*

# Editor / OS
*.swp
*~
.DS_Store

# Rust build output
/target/

# Local tooling and runtime artifacts
__pycache__/
*.py[cod]
.ruff_cache/

# Local devenv state and overrides
.devenv/
.direnv/
.devenv.*/
.devenv.flake.nix
devenv.local.nix
devenv.local.yaml

# Shared VS Code configuration; keep personal editor state ignored.
!/.vscode/
/.vscode/*
!/.vscode/settings.json
!/.vscode/extensions.json
!/.vscode/tasks.json
!/.vscode/launch.json
!/.vscode/*.code-snippets
!/.vscode/README.md
