[Unit]
Description=Weekly AUR incident scan (local list)
After=network-online.target

[Service]
Type=oneshot
Environment=AUR_RESPONSE_DIR=/usr/share/aur-response-toolkit
# --fail-on compromise: hardening/unknown-AUR warns (exit 2) do not fail the timer unit.
ExecStart=/usr/bin/aur-response --local --report --quiet --json --fail-on compromise --quick
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
